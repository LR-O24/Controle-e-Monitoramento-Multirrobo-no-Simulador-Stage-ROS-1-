<?xml version="1.0"?>
<package format="2">
  <name>multirobot_fleet</name>
  <version>1.0.0</version>
  <description>
    Controle e monitoramento de uma frota de 3 robos Pioneer 3DX no
    simulador Stage (ROS 1), com navegacao por odometria, desvio de
    obstaculos, perseguicao entre robos, telemetria acumulada, servico
    customizado de status da frota e mecanismo de emergencia por
    proximidade de colisao. Execucao distribuida multi-maquina.
  </description>

  <maintainer email="equipe@example.com">Equipe Multirobot Fleet</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/LR-O24/Controle-e-Monitoramento-Multirrobo-no-Simulador-Stage-ROS-1-</url>

  <author email="equipe@example.com">Equipe Multirobot Fleet</author>

  <!-- Dependencias de build -->
  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <!-- Dependencias de execucao -->
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>stage_ros</exec_depend>

  <export>
  </export>
</package>
